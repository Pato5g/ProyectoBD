<Window x:Class="ProyectoBD.Interfaces.AdministradorDelSistema"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProyectoBD.Interfaces"
        mc:Ignorable="d"
        Title="Administrador del Sistema"
        Height="450"
        Width="800"
        Background="DarkSlateGray">

    <Grid>
        <TabControl>

            <!-- ==================== SUCURSALES ==================== -->
            <TabItem Header="Sucursales">
                <Grid>
                    <Label Content="Gestión de Sucursales"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,10,0,0"/>

                    <Label Content="ID de la Sucursal:"
                           Margin="32,67,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                    <TextBox Name="txtIdSucursal"
                             Margin="32,90,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Width="100"
                             IsReadOnly="True"/>

                    <Label Content="Código de la Sucursal:"
                           Margin="188,67,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                    <TextBox Name="txtCodigoSucursal"
                             Margin="188,90,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Width="125"/>

                    <Label Content="Dirección de la Sucursal:"
                           Margin="397,67,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                    <TextBox Name="txtDireccionSucursal"
                             Margin="397,90,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Width="125"/>

                    <Label Content="Departamento de la Sucursal:"
                           Margin="169,140,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                    <TextBox Name="txtDepartamentoSucursal"
                             Margin="188,162,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Width="125"/>

                    <Label Content="Ciudad de la Sucursal:"
                           Margin="625,67,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                    <TextBox Name="txtCiudadSucursal"
                             Margin="625,90,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Width="125"/>

                    <Label Content="Sucursal en Funcionamiento"
                           Margin="387,140,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                    <CheckBox Name="chkSucursalFuncionando"
                              Margin="452,163,0,0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"/>

                    <Button Content="Agregar Sucursal"
                            Margin="20,203,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="125"
                            Click="Button_Click"/>

                    <Button Content="Actualizar Sucursal"
                            Margin="176,203,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="125"
                            Click="Button_Click_1"/>

                    <Button Content="Eliminar Sucursal"
                            Margin="332,203,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="125"
                            Click="Button_Click_2"/>

                    <Button Content="Buscar Sucursal"
                            Margin="488,203,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="125"
                            Click="Button_Click_3"/>

                    <Button Content="Limpiar Campos"
                            Margin="644,203,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="125"
                            Click="Button_Click_4"/>

                    <DataGrid x:Name="dtgSucursales"
                              AutoGenerateColumns="False"
                              Margin="32,246,0,0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Width="718"
                              Height="143"
                              SelectionChanged="dtgSucursales_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código"
                                                Binding="{Binding Codigo}"
                                                Width="*"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn Header="Dirección"
                                                Binding="{Binding Direccion}"
                                                Width="*"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn Header="Ciudad"
                                                Binding="{Binding Ciudad}"
                                                Width="*"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn Header="Departamento"
                                                Binding="{Binding DepartamentoGeo}"
                                                Width="*"
                                                IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>


            <!-- ==================== DEPARTAMENTOS ==================== -->
            <TabItem Header="Departamentos">
                <Grid>
                    <Label Content="Gestión de Departamentos"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,10,0,0"/>

                    <Label Content="Sucursal"
                           Margin="93,76,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                    <ComboBox Name="cmbSucursalDepartamento"
                              Margin="57,111,0,0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Width="125"
                              Height="18"
                              SelectionChanged="cmbSucursalDepartamento_SelectionChanged"/>

                    <Label Content="Departamento"
                           Margin="458,76,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                    <TextBox Name="txtDepartamento"
                             Margin="438,111,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Width="126"/>

                    <Label Content="ID Departamento"
                           Margin="253,76,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                    <TextBox Name="txtDepartamentoId"
                             Margin="244,111,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Width="126"
                             IsReadOnly="True"/>

                    <Label Content="Descripción"
                           Margin="651,76,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                    <TextBox Name="txtDescripcionDepartamento"
                             Margin="627,111,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Width="125"/>

                    <Button Content="Agregar Departamento"
                            Margin="57,159,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="125"
                            Click="Button_Click_5"/>

                    <Button Content="Actualizar Departamento"
                            Margin="196,159,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="125"
                            Click="Button_Click_6"/>

                    <Button Content="Eliminar Departamento"
                            Margin="0,159,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Width="126"
                            Click="Button_Click_7"/>

                    <Button Content="Buscar Departamento"
                            Margin="476,159,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="135"
                            Click="Button_Click_8"/>

                    <Button Content="Limpiar Campos"
                            Margin="627,159,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="125"
                            Click="Button_Click_9"/>

                    <DataGrid x:Name="dtgDepartamentos"
                              AutoGenerateColumns="False"
                              Margin="32,203,0,0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Width="718"
                              Height="186"
                              SelectionChanged="dtgDepartamentos_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                Binding="{Binding DepartamentoID}"
                                                Width="*"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn Header="Sucursal"
                                                Binding="{Binding Codigo}"
                                                Width="*"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn Header="Departamento"
                                                Binding="{Binding Nombre}"
                                                Width="*"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn Header="Descripción"
                                                Binding="{Binding Descripcion}"
                                                Width="*"
                                                IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>


            <!-- ==================== ARTÍCULOS ==================== -->
            <TabItem Header="Artículos">
                <Grid>
                    <Label Content="Gestión de Artículos"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,10,0,0"/>

                    <Label Content="Código del Artículo:"
                           Margin="91,80,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                    <TextBox Name="txtCodigoArticulo"
                             Margin="86,103,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Width="125"/>

                    <Label Content="Nombre del Artículo:"
                           Margin="0,80,0,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"/>

                    <TextBox Name="txtNombreArticulo"
                             Margin="0,103,0,0"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Top"
                             Width="126"/>

                    <Label Content="Descripción del Artículo:"
                           Margin="576,80,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                    <TextBox Name="txtDescripcionArticulo"
                             Margin="583,103,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Width="125"/>

                    <Button Content="Agregar Artículo"
                            Margin="12,161,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="126"
                            Click="Button_Click_10"/>

                    <Button Content="Actualizar Artículo"
                            Margin="234,161,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="124"
                            Click="Button_Click_11"/>

                    <Button Content="Eliminar Artículo"
                            Margin="438,161,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="124"
                            Click="Button_Click_12"/>

                    <Button Content="Buscar Artículo"
                            Margin="646,161,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="124"
                            Click="Button_Click_13"/>

                    <DataGrid x:Name="dtgArticulos"
                              AutoGenerateColumns="False"
                              Margin="12,203,0,0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Width="718"
                              Height="186"
                              SelectionChanged="dtgArticulos_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código Artículo"
                                                Binding="{Binding Codigo}"
                                                Width="*"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn Header="Nombre Artículo"
                                                Binding="{Binding Nombre}"
                                                Width="*"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn Header="Descripción Artículo"
                                                Binding="{Binding Descripcion}"
                                                Width="*"
                                                IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>


            <!-- ==================== PROVEEDORES ==================== -->
            <TabItem Header="Proveedores">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="43*"/>
                        <ColumnDefinition Width="751*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Gestión de Proveedores"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="210,15,0,0"
                           Grid.Column="1"/>

                    <Label Content="NIT del Proveedor:"
                           Margin="7,65,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Grid.Column="1"/>

                    <TextBox Name="txtNITProveedor"
                             Margin="7,97,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Width="125"
                             Grid.Column="1"/>

                    <Label Content="Nombre Comercial:"
                           Margin="7,134,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Grid.Column="1"/>

                    <TextBox Name="txtNombreComercial"
                             Margin="7,165,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Width="125"
                             Grid.Column="1"/>

                    <Label Content="Dirección:"
                           Margin="8,198,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Grid.Column="1"/>

                    <TextBox Name="txtDireccionProveedor"
                             Margin="8,229,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Width="126"
                             Grid.Column="1"/>

                    <Label Content="Teléfono:"
                           Margin="7,272,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Grid.Column="1"/>

                    <TextBox Name="txtTelefonoProveedor"
                             Margin="7,303,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Width="125"
                             Grid.Column="1"/>

                    <Label Content="Proveedor Activo:"
                           Margin="7,353,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Grid.Column="1"/>

                    <CheckBox Name="chkProveedorActivo"
                              Margin="118,358,0,0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Grid.Column="1"/>

                    <Label Content="Rubros"
                           Margin="194,65,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Grid.Column="1"/>

                    <ComboBox Name="cmbRubros"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Margin="156,97,0,0"
                              Width="125"
                              Height="18"
                              SelectionChanged="cmbRubros_SelectionChanged"
                              Grid.Column="1"/>

                    <Label Content="Artículos"
                           Margin="335,65,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Grid.Column="1"/>

                    <ComboBox Name="cmbArticulos"
                              Margin="301,97,0,0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Width="125"
                              Height="18"
                              SelectionChanged="cmbArticulos_SelectionChanged"
                              Grid.Column="1"/>

                    <Label Content="Precio Referencial:"
                           Margin="452,65,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Grid.Column="1"/>

                    <TextBox Name="txtPrecioReferencial"
                             Margin="443,97,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Width="125"
                             Grid.Column="1"/>

                    <Button Content="Agregar Proveedor"
                            Margin="583,97,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="125"
                            Height="18"
                            Grid.Column="1"
                            Click="Button_Click_14"/>

                    <Button Content="Actualizar Proveedor"
                            Margin="583,167,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="125"
                            Grid.Column="1"
                            Click="Button_Click_15"/>

                    <Button Content="Eliminar Proveedor"
                            Margin="583,248,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="125"
                            Grid.Column="1"
                            Click="Button_Click_16"/>

                    <Button Content="Buscar Proveedor"
                            Margin="583,324,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="125"
                            Grid.Column="1"
                            Click="Button_Click_17"/>
                </Grid>
            </TabItem>


            <!-- ==================== USUARIOS ==================== -->
            <TabItem Header="Usuarios">
                <Grid>
                    <Label Content="Gestión de Usuarios"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,10,0,0"/>

                    <Label Content="Nombre de Usuario:"
                           Margin="34,79,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                    <TextBox Name="txtNombreUsuario"
                             Margin="30,110,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Width="125"/>

                    <Label Content="Contraseña:"
                           Margin="205,76,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                    <PasswordBox Name="txtContraseñaUsuario"
                                 Margin="179,110,0,0"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Top"
                                 Width="125"/>

                    <Label Content="Rol:"
                           Margin="375,78,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                    <ComboBox Name="cmbRol"
                              Margin="327,110,0,0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Width="125"
                              Height="18"
                              SelectionChanged="cmbRol_SelectionChanged"/>

                    <Label Content="Proveedor:"
                           Margin="521,81,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                    <ComboBox Name="cmbProveedor"
                              Margin="492,109,0,0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Width="126"
                              Height="18"/>

                    <Label Content="Usuario Activo:"
                           Margin="654,79,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                    <CheckBox Name="chkUsuarioActivo"
                              Margin="691,110,0,0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Width="16"/>

                    <Button Content="Agregar Usuario"
                            Margin="116,235,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="125"
                            Click="Button_Click_18"/>

                    <Button Content="Actualizar Usuario"
                            Margin="266,235,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="124"
                            Click="Button_Click_19"/>

                    <Button Content="Eliminar Usuario"
                            Margin="412,235,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="125"
                            Click="Button_Click_20"/>

                    <Button Content="Buscar Usuario"
                            Margin="555,235,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="125"
                            Click="Button_Click_21"/>
                </Grid>
            </TabItem>


            <!-- ==================== ROLES Y PERMISOS ==================== -->
            <TabItem Header="Roles y Permisos">
                <Grid>
                    <Label Content="Gestión de Roles y Permisos"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="34,14,0,0"/>

                    <Label Content="Nombre del Rol:"
                           Margin="48,120,0,0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"/>

                    <TextBox Name="txtNombreRol"
                             Margin="34,151,0,0"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Top"
                             Width="125"/>

                    <DataGrid Name="dtgCargarPantallas"
                              AutoGenerateColumns="False"
                              Margin="235,61,0,0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Top"
                              Width="509"
                              Height="264"
                              SelectionChanged="dataGridPantalla_SelectionChanged">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pantalla"
                                                Binding="{Binding pantalla}"
                                                Width="*"
                                                IsReadOnly="True"/>

                            <DataGridTextColumn Header="Módulo"
                                                Binding="{Binding modulo}"
                                                Width="*"
                                                IsReadOnly="True"/>

                            <DataGridCheckBoxColumn Header="Crear"
                                                    Binding="{Binding crear}"
                                                    Width="*"/>

                            <DataGridCheckBoxColumn Header="Leer"
                                                    Binding="{Binding leer}"
                                                    Width="*"/>

                            <DataGridCheckBoxColumn Header="Actualizar"
                                                    Binding="{Binding actualizar}"
                                                    Width="*"/>

                            <DataGridCheckBoxColumn Header="Eliminar"
                                                    Binding="{Binding eliminar}"
                                                    Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Content="Agregar Rol"
                            Margin="34,245,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="125"
                            Click="Button_Click_22"/>

                    <Button Content="Actualizar Rol"
                            Margin="34,305,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="124"
                            Click="Button_Click_23"/>

                    <Button Content="Eliminar Rol"
                            Margin="235,360,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="125"
                            Click="Button_Click_24"/>

                    <Button Content="Buscar Rol"
                            Margin="427,355,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="125"
                            Click="Button_Click_25"/>

                    <Button Content="Guardar Permisos"
                            Margin="619,355,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Width="125"
                            Click="Button_Click_26"/>
                </Grid>
            </TabItem>


            <!-- ==================== SINCRONIZACIÓN ==================== -->
            <TabItem Header="Sincronización">
                <Grid>
                    <Label Content="Sincronización de Datos"
                           FontSize="24"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Top"
                           Margin="0,10,0,0"/>

                    <DataGrid Name="dtgSincronizacion"
                              AutoGenerateColumns="False"
                              Margin="0,57,0,0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Top"
                              Width="737"
                              Height="241"
                              IsReadOnly="True">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NIT"
                                                Binding="{Binding nit}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Proveedor"
                                                Binding="{Binding nombre_comercial}"
                                                Width="2*"/>

                            <DataGridTextColumn Header="Fecha"
                                                Binding="{Binding fecha_registro, StringFormat={}{0:dd/MM/yyyy}}"
                                                Width="*"/>

                            <DataGridTextColumn Header="Estado"
                                                Binding="{Binding estado}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Content="Sincronizar"
                            Margin="0,320,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Width="125"
                            Click="Button_Click_27"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>