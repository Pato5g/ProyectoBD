<Window x:Class="ProyectoBD.Interfaces.SeleccionarPedidos"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar Pedidos"
        Height="450"
        Width="750"
        WindowStartupLocation="CenterScreen"
        Background="DarkSlateGray">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Pedidos Disponibles"
                   Foreground="White"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15"/>

        <DataGrid x:Name="dtgPedidosDisponibles"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="ID"
                                    Binding="{Binding PedidoID}"
                                    Width="60"/>

                <DataGridTextColumn Header="Departamento"
                                    Binding="{Binding Departamento}"
                                    Width="*"/>

                <DataGridTextColumn Header="Artículo"
                                    Binding="{Binding Articulo}"
                                    Width="*"/>

                <DataGridTextColumn Header="Cantidad"
                                    Binding="{Binding Cantidad}"
                                    Width="80"/>

                <DataGridTextColumn Header="Fecha Solicitud"
                                    Binding="{Binding FechaSolicitud}"
                                    Width="120"/>

                <DataGridTextColumn Header="Fecha Necesidad"
                                    Binding="{Binding FechaNecesidad}"
                                    Width="120"/>

            </DataGrid.Columns>

        </DataGrid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,15,0,0">

            <Button Content="Aceptar"
                    Width="120"
                    Height="35"
                    Margin="5"
                    Click="Button_Aceptar_Click"/>

            <Button Content="Cancelar"
                    Width="120"
                    Height="35"
                    Margin="5"
                    Click="Button_Cancelar_Click"/>

        </StackPanel>

    </Grid>
</Window>