<Window x:Class="ProyectoBD.Interfaces.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProyectoBD.Interfaces"
        mc:Ignorable="d"
        Title="Main Window" Height="450" Width="800" Background="DarkSlateGray">
    <Grid>
        <Label Content="LOGIN" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>
        <Label Content="Ingrese su nombre de usuario:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="134,95,0,0"/>
        <TextBox Name="txtNombreUsuario" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="134,126,0,0" Width="170"/>
        <Label Content="Ingrese su contraseña:" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="155,149,0,0"/>
        <PasswordBox Name="passwordBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="134,180,0,0" Width="170"/>
        <Label Content="¿Olvidaste tu contraseña?" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="147,217,0,0"/>
        <Button Content="Ingresar" Width="100" Height="30" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,325,0,0" Click="Button_Click"/>
        <Label Content="No tienes cuenta? Regístrate aquí." HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,360,0,0"/>
        <Label Content="Ingrese su ROL" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="554,95,0,0"/>
        <ComboBox Name="cbxRol" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="554,126,0,0" Width="170" SelectionChanged="cbxRol_SelectionChanged">
            <ComboBoxItem Content="Administrador del Sistema"/>
            <ComboBoxItem Content="Gestor de Compras"/>
            <ComboBoxItem Content="Administrador de Proveedores"/>
            <ComboBoxItem Content="Auditor"/>
        </ComboBox>
    </Grid>
</Window>
