<Window x:Class="ProyectoBD.Interfaces.Auditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProyectoBD.Interfaces"
        mc:Ignorable="d"
        Title="Auditor" Height="450" Width="800" Background="DarkSlateGray">

    <TabControl>

        <TabItem Header="Historial de Compras">
            <Grid Background="DarkSlateGray">
                <Label Content="Historial de Compras de Artículos"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,10,0,0"/>

                <DataGrid x:Name="dtgHistorialCompras"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="10,57,10,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Proveedor" Binding="{Binding proveedor}" Width="2*"/>
                        <DataGridTextColumn Header="Artículo" Binding="{Binding articulo}" Width="2*"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding precio}" Width="*"/>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding cantidad}" Width="*"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding fecha}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Ranking">
            <Grid Background="DarkSlateGray">
                <Label Content="Ranking de Proveedores"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,10,0,0"/>

                <DataGrid x:Name="dtgRanking"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="10,57,10,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Proveedor" Binding="{Binding proveedor}" Width="2*"/>
                        <DataGridTextColumn Header="Monto" Binding="{Binding monto}" Width="*"/>
                        <DataGridTextColumn Header="Adjudicaciones" Binding="{Binding adjudicaciones}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Ofertas">
            <Grid Background="DarkSlateGray">
                <Label Content="Reporte de Ofertas"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,10,0,0"/>

                <DataGrid x:Name="dtgOfertasAuditoria"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="10,57,10,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Oferta" Binding="{Binding oferta}" Width="*"/>
                        <DataGridTextColumn Header="Proveedor" Binding="{Binding proveedor}" Width="2*"/>
                        <DataGridTextColumn Header="Artículo" Binding="{Binding articulo}" Width="2*"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding precio}" Width="*"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding fecha}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Pendientes">
            <Grid Background="DarkSlateGray">
                <Label Content="Pendientes de Auditoría"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,10,0,0"/>

                <DataGrid x:Name="dtgPendientes"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="10,57,10,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Pedido" Binding="{Binding pedido}" Width="*"/>
                        <DataGridTextColumn Header="Departamento" Binding="{Binding departamento}" Width="2*"/>
                        <DataGridTextColumn Header="Artículo" Binding="{Binding articulo}" Width="2*"/>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding cantidad}" Width="*"/>
                        <DataGridTextColumn Header="Fecha Necesidad" Binding="{Binding fecha}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Ordenes Activas">
            <Grid Background="DarkSlateGray">
                <Label Content="Órdenes Activas"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,10,0,0"/>

                <DataGrid x:Name="dtgOrdenesActivas"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="10,57,10,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Orden" Binding="{Binding orden}" Width="*"/>
                        <DataGridTextColumn Header="Descripción" Binding="{Binding descripcion}" Width="2*"/>
                        <DataGridTextColumn Header="Creación" Binding="{Binding creacion}" Width="*"/>
                        <DataGridTextColumn Header="Fecha Límite" Binding="{Binding fecha_limite}" Width="*"/>
                        <DataGridTextColumn Header="Días Restantes" Binding="{Binding dias_restantes}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Gastos">
            <Grid Background="DarkSlateGray">
                <Label Content="Gastos"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,10,0,0"/>

                <DataGrid x:Name="dtgGastos"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="10,57,10,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Proveedor" Binding="{Binding proveedor}" Width="2*"/>
                        <DataGridTextColumn Header="Compras" Binding="{Binding compras}" Width="*"/>
                        <DataGridTextColumn Header="Gasto Total" Binding="{Binding gasto}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Eficiencia">
            <Grid Background="DarkSlateGray">
                <Label Content="Eficiencia de Proveedores"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,10,0,0"/>

                <DataGrid x:Name="dtgEficiencia"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="10,57,10,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Proveedor" Binding="{Binding proveedor}" Width="2*"/>
                        <DataGridTextColumn Header="Ofertas" Binding="{Binding ofertas}" Width="*"/>
                        <DataGridTextColumn Header="Adjudicaciones" Binding="{Binding adjudicaciones}" Width="*"/>
                        <DataGridTextColumn Header="Eficiencia %" Binding="{Binding eficiencia}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Variacion">
            <Grid Background="DarkSlateGray">
                <Label Content="Variación de Precios"
                       FontSize="24"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Top"
                       Margin="0,10,0,0"/>

                <DataGrid x:Name="dtgVariacion"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Margin="10,57,10,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Artículo" Binding="{Binding articulo}" Width="2*"/>
                        <DataGridTextColumn Header="Precio Mínimo" Binding="{Binding minimo}" Width="*"/>
                        <DataGridTextColumn Header="Precio Máximo" Binding="{Binding maximo}" Width="*"/>
                        <DataGridTextColumn Header="Precio Promedio" Binding="{Binding promedio}" Width="*"/>
                        <DataGridTextColumn Header="Variación" Binding="{Binding variacion}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

    </TabControl>
</Window>